{
  "name": "project1-survey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mongo.ps1",
    "db:init": "node --env-file=.env --import tsx scripts/init-db.ts",
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/main.ts",
    "dev:web": "npm run dev -w @survey/web",
    "typecheck": "npm run build -w @survey/shared && npm run typecheck -w @survey/api && npm run typecheck -w @survey/web",
    "build": "npm run build -w @survey/shared && npm run build -w @survey/api && npm run build -w @survey/web",
    "start": "node --env-file=.env apps/api/dist/main.js",
    "test": "npm run test:integration",
    "test:phase2:acceptance": "node scripts/run-phase2-acceptance.mjs",
    "test:integration": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "node --env-file=.env --import tsx tests/browser.ts",
    "test:editor": "node --env-file=.env --import tsx tests/editor.ts",
    "test:phase1": "node scripts/run-check.mjs publish && node scripts/run-check.mjs flow && node scripts/run-check.mjs submit && node scripts/run-check.mjs statistics && node scripts/run-check.mjs edges && node scripts/run-check.mjs pagination && node scripts/run-check.mjs browser",
    "test:regression": "node scripts/run-check.mjs regression",
    "configure:phase2": "node scripts/configure-phase2.mjs",
    "db:init:phase2": "node --env-file=.env.phase2 --import tsx scripts/init-phase2-app.ts",
    "db:verify:phase2": "node --env-file=.env.phase2 --import tsx scripts/init-phase2-app.ts --verify",
    "dev:api:phase2": "node --env-file=.env.phase2 --import tsx --watch apps/api/src/main-phase2.ts",
    "dev:web:phase2": "npm run dev -w @survey/web -- --mode phase2",
    "start:phase2": "node --env-file=.env.phase2 apps/api/dist/main-phase2.js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "@playwright/test": "1.64.1"
  }
}
